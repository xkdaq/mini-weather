/* 页面基础 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #5A6B6D 0%, #718184 50%, #8A9A9C 100%);
  position: relative;
  overflow: hidden;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
}

/* 自定义导航栏 */
.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  padding: 64rpx 0 0;
  margin: 0 -40rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left,
.nav-right {
  width: 80rpx;
  height: 80rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 背景装饰 */
.bg-decoration {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
}

.circle-1 {
  width: 600rpx;
  height: 600rpx;
  top: -200rpx;
  right: -200rpx;
}

.circle-2 {
  width: 400rpx;
  height: 400rpx;
  bottom: 20%;
  left: -150rpx;
}

.circle-3 {
  width: 300rpx;
  height: 300rpx;
  bottom: -100rpx;
  right: 10%;
}

/* 顶部头部 */
.header {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.location {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.location-icon {
  font-size: 28rpx;
}

.city-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.update-time {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

/* 当前天气卡片 */
.current-card {
  position: relative;
  z-index: 1;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(20rpx);
  border-radius: 40rpx;
  padding: 10rpx 40rpx 40rpx 40rpx;
  margin-bottom: 0rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.weather-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.weather-icon {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 8rpx;
  filter: drop-shadow(0 8rpx 24rpx rgba(0,0,0,0.15));
}

.temp-box {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.temp {
  font-size: 100rpx;
  font-weight: 200;
  color: #ffffff;
  line-height: 1;
  letter-spacing: -4rpx;
}

.temp-unit {
  font-size: 40rpx;
  font-weight: 300;
  color: rgba(255,255,255,0.8);
  margin-top: 16rpx;
}

.weather-text {
  font-size: 32rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.9);
}

/* 天气详情 */
.weather-details {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 24rpx;
  position: relative;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.detail-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.detail-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.detail-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.15);
}

.detail-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}

.arrow-icon {
  font-size: 32rpx;
  color: rgba(255,255,255,0.4);
}

/* 骨架屏 */
.skeleton-card {
  position: relative;
  z-index: 1;
  background: rgba(255,255,255,0.08);
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.skeleton-icon {
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
  margin-bottom: 16rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

.skeleton-temp {
  width: 200rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

.skeleton-text {
  width: 120rpx;
  height: 36rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 8rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

/* 预报区域 */
.forecast-section {
  position: relative;
  z-index: 1;
}

.section-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.section-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  font-weight: 300;
}

/* 预报列表 */
.forecast-list {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(10rpx);
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
}

.forecast-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}

.forecast-item:last-child {
  border-bottom: none;
}

.forecast-item.today {
  background: rgba(255,255,255,0.06);
  border-radius: 20rpx;
  margin: 8rpx 0;
  border-bottom: none;
}

.forecast-day {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.day-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.day-date {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

.forecast-weather {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.forecast-icon {
  width: 48rpx;
  height: 48rpx;
}

.weather-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.forecast-temp {
  width: 200rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.temp-low {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  width: 50rpx;
  text-align: left;
}

.temp-high {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
  width: 50rpx;
  text-align: right;
}

.temp-bar {
  flex: 1;
  height: 4rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 2rpx;
  position: relative;
}

.temp-progress {
  position: absolute;
  height: 100%;
  background: linear-gradient(90deg, rgba(255,255,255,0.4), rgba(255,255,255,0.8));
  border-radius: 2rpx;
}

/* 定位失败 */
.location-fail {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  text-align: center;
}

.fail-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.fail-text {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 48rpx;
}

.retry-btn {
  background: rgba(255,255,255,0.15);
  color: #ffffff;
  border: 1rpx solid rgba(255,255,255,0.2);
  border-radius: 40rpx;
  padding: 24rpx 56rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.retry-btn:active {
  background: rgba(255,255,255,0.25);
}
