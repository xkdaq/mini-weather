/* pages/tools/bookkeeping/home/home.wxss */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

/* 余额卡片 */
.balance-card {
  background: linear-gradient(180deg, #FF6B35, #F7931E);
  border-radius: 0 0 40rpx 40rpx;
  padding: 48rpx 32rpx 40rpx;
  color: white;
  margin-bottom: 32rpx;
}

.balance-label {
  font-size: var(--font-sm);
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.balance-amount {
  font-size: 72rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

.balance-stats {
  display: flex;
  gap: 24rpx;
}

.balance-stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.balance-stat-label {
  font-size: var(--font-xs);
  opacity: 0.8;
}

.balance-stat-value {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.balance-stat-value.expense {
  color: #FFD9D9;
}

.balance-stat-value.income {
  color: #D9FFE4;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.quick-btn {
  flex: 1;
  background: white;
  border-radius: var(--radius-lg);
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.quick-btn:active {
  transform: scale(0.96);
}

.quick-btn-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 16rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-btn-icon.spend {
  background: linear-gradient(135deg, #FFF1F0, #FFE8E8);
}

.quick-btn-icon.income {
  background: linear-gradient(135deg, #E8FFF0, #D9F7BE);
}

.quick-btn-icon .icon {
  font-size: 40rpx;
}

.quick-btn-label {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-primary);
}

.quick-btn-desc {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

/* 标题 */
.section-title .icon {
  font-size: 32rpx;
  padding-left: 20rpx;
}

.title-count {
  font-weight: 400;
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

/* 用户列表 */
.user-list {
  background: white;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin: 0 32rpx;
  box-shadow: var(--shadow-sm);
}

.user-list.paused {
  opacity: 0.7;
}

.user-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 24rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.user-item:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.user-name.paused {
  color: var(--color-text-tertiary);
}

.user-note {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-balance {
  text-align: right;
}

.user-balance-value {
  font-size: 32rpx;
  font-weight: 700;
}

.user-balance-value.negative {
  color: var(--color-expense);
}

.user-balance-value.positive {
  color: var(--color-income);
}

.user-balance-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  margin: 0 32rpx;
  background: white;
  border-radius: var(--radius-lg);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
}

.link {
  color: var(--color-primary);
}

/* 暂停服务样式 */
.paused {
  opacity: 0.6;
}
