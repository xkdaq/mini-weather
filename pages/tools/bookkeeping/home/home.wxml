<!--pages/tools/bookkeeping/home/home.wxml-->
<view class="page">
  <!-- 顶部 Banner -->
  <view class="balance-card">
    <view class="balance-label">当前总欠款（别人欠你）</view>
    <view class="balance-amount">¥ {{totalOwed}}</view>
    <view class="balance-stats">
      <view class="balance-stat">
        <view class="balance-stat-label">本月支出</view>
        <view class="balance-stat-value expense">¥{{monthExpense}}</view>
      </view>
      <view class="balance-stat">
        <view class="balance-stat-label">本月收款</view>
        <view class="balance-stat-value income">¥{{monthIncome}}</view>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="quick-btn" bindtap="goToRecord" data-type="expense">
      <view class="quick-btn-icon spend">
        <text class="icon">🛒</text>
      </view>
      <view class="quick-btn-label">记支出</view>
      <view class="quick-btn-desc">买早餐</view>
    </view>
    <view class="quick-btn" bindtap="goToRecord" data-type="income">
      <view class="quick-btn-icon income">
        <text class="icon">💰</text>
      </view>
      <view class="quick-btn-label">记收款</view>
      <view class="quick-btn-desc">收钱啦</view>
    </view>
    <view class="quick-btn" bindtap="goToTransactions">
      <view class="quick-btn-icon">
        <text class="icon">📋</text>
      </view>
      <view class="quick-btn-label">流水</view>
      <view class="quick-btn-desc">查记录</view>
    </view>
  </view>

  <!-- 用户余额列表 -->
  <view class="section-title">
    <text class="icon"></text>
    用户余额
    <text class="title-count">({{activeUsers.length}}人)</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{activeUsers.length === 0}}">
    <view class="empty-icon">🥐</view>
    <view class="empty-text">还没有用户，<text class="link" bindtap="goToAddUser">点击添加</text></view>
  </view>

  <!-- 用户列表 -->
  <view class="user-list" wx:else>
    <view
      class="user-item"
      wx:for="{{activeUsers}}"
      wx:key="id"
      bindtap="goToUserDetail"
      data-id="{{item.id}}"
    >
      <view class="user-avatar" style="background: {{item.avatar_color}}">
        {{item.name[0]}}
      </view>
      <view class="user-info">
        <view class="user-name">{{item.name}}</view>
        <view class="user-note" wx:if="{{item.lastTransaction}}">{{item.lastTransaction}}</view>
        <view class="user-note" wx:else>暂无记录</view>
      </view>
      <view class="user-balance">
        <view class="user-balance-value {{item.balance < 0 ? 'negative' : 'positive'}}">
          {{item.balanceDisplay}}
        </view>
        <view class="user-balance-label">{{item.balance < 0 ? '还差这么多' : '有余额'}}</view>
      </view>
    </view>
  </view>

  <!-- 暂停用户 -->
  <view class="section-title" wx:if="{{users.length > activeUsers.length}}">
    <text class="icon"></text>
    暂停服务
  </view>
  <view class="user-list paused" wx:if="{{users.length > activeUsers.length}}">
    <view
      class="user-item"
      wx:for="{{users}}"
      wx:key="id"
      wx:if="{{item.status === 'paused'}}"
    >
      <view class="user-avatar" style="background: {{item.avatar_color}}; opacity: 0.5">
        {{item.name[0]}}
      </view>
      <view class="user-info">
        <view class="user-name paused">{{item.name}}</view>
        <view class="user-note">已暂停服务</view>
      </view>
    </view>
  </view>
</view>
