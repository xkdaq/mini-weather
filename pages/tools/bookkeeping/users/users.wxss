/* pages/tools/bookkeeping/users/users.wxss */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 自定义导航栏 */
.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  background: #FF6B35;
  padding: 0 24rpx;
  padding-top: 64rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -20rpx;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
}

.nav-right {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  font-size: 40rpx;
  color: white;
  font-weight: 300;
}

/* 页面内容 */
.content {
  padding: 32rpx;
  padding-bottom: 40rpx;
}

/* 用户列表 */
.user-list {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.section-title.paused-title {
  margin-top: 48rpx;
}

.user-items {
  background: white;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.user-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 24rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.user-item:last-child {
  border-bottom: none;
}

.user-item.paused {
  opacity: 0.6;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.user-note {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.user-balance {
  text-align: right;
}

.user-balance-value {
  font-size: 32rpx;
  font-weight: 700;
}

.user-balance-value.negative {
  color: var(--color-expense);
}

.user-balance-value.positive {
  color: var(--color-income);
}

.user-balance-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  background: white;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  margin-bottom: 32rpx;
}

.add-btn {
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: white;
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  font-size: var(--font-base);
  font-weight: 600;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal {
  background: white;
  border-radius: var(--radius-xl);
  padding: 48rpx;
  width: 80%;
  max-width: 600rpx;
}

.modal-header {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 32rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.form-label .required {
  color: var(--color-expense);
}

.form-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  box-sizing: border-box;
}

/* 颜色选择器 */
.color-picker {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.color-item {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: 700;
}

.color-item.active {
  box-shadow: 0 0 0 4rpx white, 0 0 0 8rpx var(--color-primary);
}

/* 弹窗按钮 */
.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.btn-cancel {
  flex: 1;
  background: #F5F5F5;
  color: var(--color-text-secondary);
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-base);
}

.btn-confirm {
  flex: 1;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: white;
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-base);
  font-weight: 600;
}
