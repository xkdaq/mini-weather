/* pages/tools/bookkeeping/transactions/transactions.wxss */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 筛选标签 */
.filter-tabs {
  background: white;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.tabs-wrapper {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
  white-space: nowrap;
}

.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #F5F5F5;
  border-radius: 28rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.tab.active {
  background: var(--color-primary);
  color: white;
  font-weight: 500;
}

/* 流水列表 */
.transaction-list {
  padding: 24rpx 32rpx;
}

.transaction-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.trans-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.trans-icon.expense {
  background: #FFF1F0;
}

.trans-icon.income {
  background: #E8FFF0;
}

.trans-icon .icon {
  font-size: 36rpx;
}

.trans-info {
  flex: 1;
  min-width: 0;
}

.trans-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.trans-date {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.trans-amount {
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.trans-amount.expense {
  color: var(--color-expense);
}

.trans-amount.income {
  color: var(--color-income);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  margin-bottom: 32rpx;
}

.add-btn {
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: white;
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  font-size: var(--font-base);
  font-weight: 600;
}
