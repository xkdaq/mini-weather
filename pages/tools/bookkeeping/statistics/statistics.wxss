/* pages/tools/bookkeeping/statistics/statistics.wxss */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 自定义导航栏 */
.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B35, #F7931E);
  padding: 0 24rpx;
  padding-top: 64rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: white;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
}

.nav-right {
  width: 60rpx;
}

/* 页面内容 */
.content {
  padding: 32rpx;
  padding-bottom: 40rpx;
}

/* 时间段标签 */
.period-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  background: white;
  border-radius: var(--radius-md);
  padding: 20rpx;
  text-align: center;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  box-shadow: var(--shadow-sm);
}

.tab.active {
  background: var(--color-primary);
  color: white;
  font-weight: 600;
}

/* 汇总卡片 */
.summary-card {
  display: flex;
  background: white;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
}

.summary-item {
  flex: 1;
  text-align: center;
  border-right: 2rpx solid var(--color-border);
}

.summary-item:last-child {
  border-right: none;
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.summary-value.expense {
  color: var(--color-expense);
}

.summary-value.income {
  color: var(--color-income);
}

.summary-value.owed {
  color: var(--color-primary);
}

.summary-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* 标题 */
.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

/* 欠款列表 */
.debt-list {
  background: white;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
}

.debt-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.debt-item:last-child {
  border-bottom: none;
}

.debt-rank {
  width: 48rpx;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-tertiary);
}

.debt-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: white;
  margin-right: 20rpx;
}

.debt-info {
  flex: 1;
}

.debt-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-primary);
}

.debt-amount {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-expense);
}

/* 趋势图表 */
.trend-chart {
  background: white;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 300rpx;
  box-shadow: var(--shadow-sm);
}

.trend-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 16rpx;
}

.trend-bar {
  width: 16rpx;
  background: var(--color-border);
  border-radius: 8rpx;
  transition: all 0.3s;
}

.trend-bar.has-data {
  background: linear-gradient(180deg, var(--color-primary), var(--color-secondary));
}

.trend-day {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  margin-bottom: 4rpx;
}

.trend-date {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  background: white;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
}
