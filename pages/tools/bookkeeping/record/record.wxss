/* pages/tools/bookkeeping/record/record.wxss */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 自定义导航栏 */
.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  background: #FF6B35;
  padding: 0 24rpx;
  padding-top: 64rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -20rpx;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: white;
}

.nav-right {
  width: 60rpx;
}

/* 页面内容 */
.content {
  padding: 32rpx;
}

/* 编辑提示 */
.edit-tip {
  background: #FFF7E6;
  border: 2rpx solid #FFD591;
  border-radius: var(--radius-md);
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
  font-size: var(--font-sm);
  color: #D46B08;
}

/* 类型切换 */
.type-switch {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.type-btn {
  flex: 1;
  background: white;
  border: 4rpx solid transparent;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  text-align: center;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.type-btn .icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.type-btn.active {
  font-weight: 600;
}

.type-btn.active.expense {
  border-color: var(--color-expense);
  color: var(--color-expense);
  background: #FFF1F0;
}

.type-btn.active.income {
  border-color: var(--color-income);
  color: var(--color-income);
  background: #E8FFF0;
}

/* 表单卡片 */
.form-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  display: block;
}

/* 选择器 */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: white;
}

.form-picker .arrow {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.form-picker .placeholder {
  color: var(--color-text-tertiary);
}

/* 用户选择 */
.user-selected {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-avatar-mini {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: white;
}

.current-balance {
  margin-top: 16rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.current-balance .negative {
  color: var(--color-expense);
  font-weight: 600;
}

.current-balance .positive {
  color: var(--color-income);
  font-weight: 600;
}

/* 金额输入 */
.amount-input-wrap {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: white;
}

.currency {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: 600;
  border: none;
  outline: none;
}

/* 快速金额 */
.quick-amounts {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-btn {
  flex: 1;
  background: #F5F5F5;
  border-radius: var(--radius-md);
  padding: 16rpx;
  text-align: center;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: 500;
}

.quick-btn:active {
  background: var(--color-primary-light);
  color: white;
}

/* 普通输入框 */
.form-input {
  width: 100%;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  background: white;
  box-sizing: border-box;
}

/* 提交区域 */
.submit-section {
  margin-top: 48rpx;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: white;
  border: none;
  border-radius: var(--radius-md);
  padding: 32rpx;
  font-size: var(--font-lg);
  font-weight: 600;
  text-align: center;
}

.submit-btn.disabled {
  background: #CCCCCC;
  color: #999999;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
