<!--pages/hourly/hourly.wxml-->
<view class="page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack">
      <image class="back-icon" src="/images/app/back.png" mode="aspectFit"/>
    </view>
    <view class="nav-title">{{city}} 24小时</view>
    <view class="nav-right"></view>
  </view>

  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="bg-circle circle-1"></view>
    <view class="bg-circle circle-2"></view>
  </view>

  <!-- 温度趋势图 -->
  <view class="chart-section" wx:if="{{hourlyList.length > 0}}">
    <view class="chart-container">
      <view class="chart-line">
        <view 
          class="temp-point"
          wx:for="{{hourlyList}}"
          wx:key="index"
          style="left: {{index * (100 / (hourlyList.length - 1))}}%; bottom: {{(item.temp - minTemp) / (maxTemp - minTemp) * 160 + 40}}rpx"
        >
          <text class="point-temp" wx:if="{{index % 3 === 0}}">{{item.temp}}°</text>
          <view class="point-dot {{index % 3 === 0 ? 'highlight' : ''}}"></view>
        </view>
        <view class="chart-area"></view>
      </view>
      <view class="chart-labels">
        <text 
          class="time-label"
          wx:for="{{hourlyList}}"
          wx:key="index"
          wx:if="{{index % 3 === 0}}"
          style="left: {{index * (100 / (hourlyList.length - 1))}}%"
        >{{item.time}}</text>
      </view>
    </view>
  </view>

  <!-- 小时列表 -->
  <scroll-view
    scroll-y="true"
    class="hourly-scroll"
    show-scrollbar="false"
  >
    <view class="list-container">
      <view 
        class="hour-item {{index === 0 ? 'current' : ''}}"
        wx:for="{{hourlyList}}"
        wx:key="index"
      >
        <view class="time-section">
          <text class="time">{{item.time}}</text>
          <text class="period" wx:if="{{index === 0}}">现在</text>
          <text class="period" wx:elif="{{item.time >= '06:00' && item.time < '18:00'}}">白天</text>
          <text class="period" wx:else>夜间</text>
        </view>

        <view class="weather-section">
          <image class="weather-icon" src="{{item.icon}}" mode="aspectFit"/>
          <text class="weather-text">{{item.weather}}</text>
        </view>

        <view class="temp-section">
          <text class="temp">{{item.temp}}°</text>
          <view class="temp-bar">
            <view 
              class="temp-fill"
              style="width: {{(item.temp - minTemp) / (maxTemp - minTemp) * 100}}%"
            ></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
