/* pages/hourly/hourly.wxss */

/* 页面基础 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #5A6B6D 0%, #718184 50%, #8A9A9C 100%);
  position: relative;
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏 */
.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  padding: 64rpx 40rpx 0;
  position: relative;
  z-index: 100;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -20rpx;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.nav-right {
  width: 80rpx;
  height: 80rpx;
}

/* 背景装饰 */
.bg-decoration {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%);
}

.circle-1 {
  width: 500rpx;
  height: 500rpx;
  top: -150rpx;
  right: -150rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  bottom: 10%;
  left: -100rpx;
}

/* 图表区域 */
.chart-section {
  position: relative;
  z-index: 1;
  padding: 20rpx 40rpx 40rpx;
}

.chart-container {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(10rpx);
  border-radius: 32rpx;
  padding: 40rpx 48rpx 80rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
  position: relative;
  height: 280rpx;
  overflow: hidden;
}

.chart-line {
  position: relative;
  height: 200rpx;
}

.temp-point {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
}

.point-temp {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.point-dot {
  width: 12rpx;
  height: 12rpx;
  background: rgba(255,255,255,0.4);
  border-radius: 50%;
}

.point-dot.highlight {
  width: 16rpx;
  height: 16rpx;
  background: #ffffff;
  box-shadow: 0 0 12rpx rgba(255,255,255,0.5);
}

.chart-area {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.1) 0%, transparent 100%);
  border-radius: 8rpx;
}

.chart-labels {
  position: absolute;
  bottom: 20rpx;
  left: 48rpx;
  right: 48rpx;
  height: 40rpx;
}

.time-label {
  position: absolute;
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  transform: translateX(-50%);
}

/* 列表区域 */
.hourly-scroll {
  flex: 1;
  position: relative;
  z-index: 1;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
  width: 100%;
}

.list-container {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(10rpx);
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
  box-sizing: border-box;
  width: 100%;
}

.hour-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
  box-sizing: border-box;
  width: 100%;
}

.hour-item:last-child {
  border-bottom: none;
}

.hour-item.current {
  background: rgba(255,255,255,0.06);
  border-radius: 20rpx;
  margin: 8rpx 0;
  border-bottom: none;
}

/* 时间区域 */
.time-section {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex-shrink: 0;
}

.time {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.period {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

/* 天气区域 */
.weather-section {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  padding: 0 8rpx;
}

.weather-icon {
  width: 48rpx;
  height: 48rpx;
}

.weather-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 温度区域 */
.temp-section {
  width: 140rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.temp {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  width: 50rpx;
  text-align: right;
  flex-shrink: 0;
}

.temp-bar {
  flex: 1;
  height: 4rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 2rpx;
  overflow: hidden;
}

.temp-fill {
  height: 100%;
  background: linear-gradient(90deg, rgba(255,255,255,0.4), rgba(255,255,255,0.8));
  border-radius: 2rpx;
  min-width: 4rpx;
}
